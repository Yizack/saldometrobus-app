{
  "private": true,
  "name": "saldometrobus-app",
  "version": "2.8.10",
  "description": "Saldo Metrobús es un sitio de consultas de saldo y movimientos para las tarjetas de metro y metrobús de Panamá a cualquier hora del día.",
  "author": {
    "name": "Yizack Rangel",
    "email": "yizackr@gmail.com",
    "url": "https://yizack.com"
  },
  "license": "MIT",
  "type": "module",
  "homepage": "https://saldometrobus.yizack.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yizack/saldometrobus-app.git"
  },
  "bugs": "https://github.com/Yizack/saldometrobus-app/issues",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port=5174 --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "android": "cap add android",
    "ios": "cap add ios",
    "resources": "@capacitor/assets generate --android --iconBackgroundColor #F8F9FC --splashBackgroundColorDark #F8F9FC --splashBackgroundColor #F8F9FC --assetPath app/assets",
    "sync": "cap sync",
    "app:clean": "node scripts/clean-output.ts",
    "app:mibus": "node scripts/mibus-rutas.ts",
    "app:version": "node scripts/update-version.ts",
    "app:android:key": "openssl base64 -A -in saldometrobus_key.jks -out saldometrobus_key.jks.txt",
    "trapeze": "trapeze run config.yaml -y",
    "release": "changelogen --bump && node scripts/new-release.ts && changelogen gh release",
    "release:patch": "changelogen --bump --patch && node scripts/new-release.ts && changelogen gh release",
    "test:types": "vue-tsc -b --noEmit",
    "lint": "node --run lint:eslint && node --run lint:stylelint",
    "lint:eslint": "eslint --fix --config .config/eslint.mjs",
    "lint:stylelint": "stylelint \"**/*.css\" --fix --config .config/stylelint.json",
    "dev:build": "node --run app:mibus && node --run generate && node --run app:clean && node --run sync"
  },
  "devDependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capacitor/toast": "^8.0.1",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@capawesome/capacitor-app-update": "^8.0.3",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/icon": "^2.4.1",
    "@trapezedev/configure": "^7.1.4",
    "@types/bootstrap": "^5.2.11",
    "@types/google.maps": "^3.65.5",
    "@types/node": "^26.2.0",
    "changelogen": "^0.6.2",
    "cheerio": "^1.2.0",
    "eslint": "^10.8.1",
    "firebase": "^12.17.1",
    "jeep-sqlite": "^2.8.0",
    "nuxt": "^4.5.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@pinia/nuxt": "^1.0.1",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "leaflet-geosearch": "^4.4.0"
  },
  "packageManager": "pnpm@12.2.1"
}
